        <mxCell id="w-m3" value="3. UPDATE order + INSERT history" style="edgeStyle=none;endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="485" y="990" as="sourcePoint" /><mxPoint x="910" y="990" as="targetPoint" /></mxGeometry></mxCell>
