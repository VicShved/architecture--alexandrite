        <mxCell id="r-note1" value="Первая страница по статусу, TTL 30–60 с. После записи ключи удаляются." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="30" y="750" width="500" height="56" as="geometry" /></mxCell>
